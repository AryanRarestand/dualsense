;
; DualSenseBth.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider    = %ManufacturerName%
CatalogFile = DualSenseBth.cat
DriverVer = 09/15/2026,20.27.54.294
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
DualSenseBth.sys  = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...16299

[Standard.NTamd64.10.0...16299]
%DualSenseBth.FilterDesc% = DualSenseBth_Filter, HID\{00001124-0000-1000-8000-00805f9b34fb}_VID&0002054c_PID&0ce6
%DualSenseBth.VirtualDesc% = DualSenseBth_Virtual, BTHENUM\VirtualDualSense

; ==========================================================
; Real DualSense (Filter-Bus) Installation
; ==========================================================
[DualSenseBth_Filter.NT]
CopyFiles = File_Copy

[DualSenseBth_Filter.NT.HW]
AddReg = DualSenseBth_Filter.HW.AddReg

[DualSenseBth_Filter.HW.AddReg]
HKR,,"UpperFilters",0x00010000,"DualSenseBth"

[DualSenseBth_Filter.NT.Services]
AddService = ,0x00000002  ; null service install
AddService = DualSenseBth,, DualSenseBth_Service_Inst

; ==========================================================
; Virtual DualSense (Function) Installation
; ==========================================================
[DualSenseBth_Virtual.NT]
Include = mshidkmdf.inf
Needs = mshidkmdf.NT
CopyFiles = File_Copy

[DualSenseBth_Virtual.NT.HW]
Include = mshidkmdf.inf
Needs = mshidkmdf.NT.HW
AddReg = DualSenseBth_Virtual.HW.AddReg

[DualSenseBth_Virtual.HW.AddReg]
HKR,,"LowerFilters",0x00010000,"DualSenseBth"

[DualSenseBth_Virtual.NT.Services]
Include = mshidkmdf.inf
Needs = mshidkmdf.NT.Services
AddService = DualSenseBth,, DualSenseBth_Service_Inst

; ==========================================================
; Common Sections
; ==========================================================

[File_Copy]
DualSenseBth.sys

[DualSenseBth_Service_Inst]
DisplayName    = %DualSenseBth.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\DualSenseBth.sys

[DualSenseBth_Filter.NT.Wdf]
KmdfService = DualSenseBth, DualSenseBth_wdfsect

[DualSenseBth_Virtual.NT.Wdf]
KmdfService = DualSenseBth, DualSenseBth_wdfsect

[DualSenseBth_wdfsect]
KmdfLibraryVersion = 1.15

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "Alian"
DiskName = "DualSenseBth Installation Disk"
DualSenseBth.FilterDesc = "DualSenseBth Controller Hider (Filter)"
DualSenseBth.VirtualDesc = "DualSenseBth Virtual Controller"
DualSenseBth.SVCDESC = "DualSenseBth Driver"
